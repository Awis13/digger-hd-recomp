diff --git a/runtime/spu/spu_dma.h b/runtime/spu/spu_dma.h
index 8c4ccaa8..b6ae8526 100644
--- a/runtime/spu/spu_dma.h
+++ b/runtime/spu/spu_dma.h
@@ -680,6 +680,18 @@ static inline int mfc_do_transfer(spu_context* spu, uint32_t lsa, uint64_t ea,
             extern void spu_lockline_unlock(void);
             extern void spu_lockguard_check(spu_context*, uint32_t, const uint8_t*, uint32_t, const char*);
             spu_lockguard_check(spu, (uint32_t)ea, (const uint8_t*)ls_ptr, size, "PUT");
+            /* GCM_RECDBG: remember SPU stores that overwrite a self-JUMP park
+             * in the RSX ring, so a park that stands can be checked against
+             * the unparks that already happened (cellGcmSys.c prints them). */
+            { extern int gcm_park_word_at(uint32_t ea);
+              extern void gcm_note_spu_unpark(uint32_t ea, uint32_t word);
+              if (size <= 64u && !((uint32_t)ea & 3u))
+                  for (uint32_t o = 0; o + 4u <= size; o += 4u)
+                      if (gcm_park_word_at((uint32_t)ea + o)) {
+                          const uint8_t* w = (const uint8_t*)ls_ptr + o;
+                          gcm_note_spu_unpark((uint32_t)ea + o,
+                              ((uint32_t)w[0] << 24) | ((uint32_t)w[1] << 16) | ((uint32_t)w[2] << 8) | w[3]);
+                      } }
             uint32_t a0 = (uint32_t)ea & ~127u;
             uint32_t a1 = ((uint32_t)ea + size - 1u) & ~127u;
             int span_reserved = 0;
