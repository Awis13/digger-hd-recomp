diff --git a/libs/video/rsx_texture_layout.c b/libs/video/rsx_texture_layout.c
index 51a30a23..9a1506e3 100644
--- a/libs/video/rsx_texture_layout.c
+++ b/libs/video/rsx_texture_layout.c
@@ -104,6 +104,11 @@ void rsx_texture_layout_pitched(u32 rsx_fmt, u32 w, u32 h, u32 pitch,
         out->rows      = (h + 3u) / 4u;
         out->dst_bytes_per_texel = 0;
         out->dst_row_bytes       = out->row_bytes;
+        /* A linear (LN) compressed image spaces its block rows by the pitch
+         * register like any linear image (RPCS3 get_subresources_layout_impl:
+         * padded_row for every !is_swizzled format, block-compressed too). */
+        if (pitch > out->row_bytes && (rsx_fmt & 0x20u))
+            out->row_bytes = pitch;
     } else {
         /* Swizzled unless the LN bit is set. The hardware requires power-of-two
          * dimensions to swizzle, so a NPOT image is linear regardless. */
@@ -135,9 +140,14 @@ u32 rsx_texture_mip_chain(u32 rsx_fmt, u32 w, u32 h, u32 levels, u32 pitch,
     while (n < levels) {
         rsx_tex_level* lv = &out[n];
         lv->w = mw; lv->h = mh; lv->offset = off;
-        /* Only level 0 has a pitch register; the rest are packed at their own
