+/* PAD_SCRIPT=<file>: drive port 0 from a timed script, for unattended runs
+ * that must get past menus and play. Each line is "<ms> <buttons>": from <ms>
+ * on the host monotonic clock (CLOCK_MONOTONIC, in milliseconds), hold
+ * <buttons> (a CELL_PAD_CTRL_* mask, hex or decimal) until the next line's
+ * time. Blank lines and lines starting with '#' are skipped; lines must be in
+ * time order. The file is re-read when it changes, so a test harness can
+ * append presses as it sees the screens they answer. While the variable is set
+ * the script replaces every other input on port 0, pressing nothing before its
+ * first line. The clock is printed once at the first poll for alignment. */
+#define PAD_SCRIPT_MAX 4096
+static struct { unsigned long long ms; u16 btn; } s_script[PAD_SCRIPT_MAX];
+static int s_script_n = -1;          /* -1: PAD_SCRIPT not looked at yet */
+static const char* s_script_path;
+static long long s_script_mtime = -1;
+static unsigned long long s_script_checked;
+
+/* Modification time in nanoseconds: a harness appends within one second. */
+static long long pad_file_mtime_ns(const struct stat* st)
+{
+#if defined(__APPLE__)
+    return (long long)st->st_mtimespec.tv_sec * 1000000000ll + st->st_mtimespec.tv_nsec;
+#elif defined(_WIN32)
+    return (long long)st->st_mtime * 1000000000ll;
+#else
+    return (long long)st->st_mtim.tv_sec * 1000000000ll + st->st_mtim.tv_nsec;
+#endif
+}
+
+static void pad_script_load(void)
+{
+    struct stat st;
+    if (stat(s_script_path, &st) != 0) return;
+    if (pad_file_mtime_ns(&st) == s_script_mtime) return;
+    FILE* f = fopen(s_script_path, "r");
+    if (!f) return;
+    s_script_mtime = pad_file_mtime_ns(&st);
+    int n = 0;
+    char line[256];
+    while (n < PAD_SCRIPT_MAX && fgets(line, sizeof line, f)) {
+        char* p = line;
+        while (*p == ' ' || *p == '\t') p++;
+        if (*p == '#' || *p == '\n' || *p == '\r' || !*p) continue;
+        char* e;
+        unsigned long long ms = strtoull(p, &e, 0);
+        if (e == p) continue;
+        s_script[n].ms = ms;
+        s_script[n].btn = (u16)strtoul(e, NULL, 0);
+        n++;
+    }
+    fclose(f);
+    s_script_n = n;
+}
+
+static unsigned long long pad_mono_ms(void)
+{
+#ifdef _WIN32
+    return (unsigned long long)GetTickCount64();
+#else
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (unsigned long long)ts.tv_sec * 1000ull +
+           (unsigned long long)ts.tv_nsec / 1000000ull;
+#endif
+}
+
+static void pad_poll_script(unsigned long long now)
+{
+    (void)now;
+    if (s_script_n < 0) {
+        s_script_path = getenv("PAD_SCRIPT");
+        if (!s_script_path || !*s_script_path) { s_script_path = NULL; s_script_n = 0; return; }
+        s_script_n = 0;
+        printf("[cellPad] PAD_SCRIPT %s: clock %llu ms\n", s_script_path, pad_mono_ms());
+        fflush(stdout);
+    }
+    if (!s_script_path) return;
+    const unsigned long long t = pad_mono_ms();
+    if (t - s_script_checked >= 100) { s_script_checked = t; pad_script_load(); }
+    u16 btns = 0;
+    int i = 0;
+    while (i < s_script_n && s_script[i].ms <= t) i++;
+    if (i > 0) btns = s_script[i - 1].btn;
+    { static int last = -1;
+      if (i != last) { last = i;
+          printf("[cellPad] PAD_SCRIPT t=%llu ms step %d buttons=0x%04X\n", t, i, btns);
+          fflush(stdout); } }
+    PadHostState* hs = &s_host_state[0];
+    hs->buttons   = btns;
+    hs->connected = 1;
+    hs->analog_lx = (u8)((btns & CELL_PAD_CTRL_LEFT) ? 0 :
+                         (btns & CELL_PAD_CTRL_RIGHT) ? 255 : 128);
+    hs->analog_ly = (u8)((btns & CELL_PAD_CTRL_UP) ? 0 :
+                         (btns & CELL_PAD_CTRL_DOWN) ? 255 : 128);
+    hs->analog_rx = hs->analog_ry = 128;
+    hs->trigger_l2 = (u8)((btns & CELL_PAD_CTRL_L2) ? 255 : 0);
+    hs->trigger_r2 = (u8)((btns & CELL_PAD_CTRL_R2) ? 255 : 0);
+}
+
+/* PAD_AUTOPLAY=1: the Mac playtest's route (tools/playtest.py) run on the
+ * device itself, for one nobody can sit at. The Metal backend recognises the
+ * screen from the frame against the playtest's reference thumbnails
+ * (tools/make_autoplay_refs.py) and publishes it here; this answers it as
+ * the playtest does -- START on the title, cross in the menu, circle in a
+ * pause, square on game over, and in a level a random direction for
+ * 0.3-1.2 s every 0.4 s with fire on a third of them. OR-ed onto port 0, so
+ * a controller in a hand still works. */
+volatile int g_autoplay_screen = -1;
+/* The iOS host sends these lines over the network (PS3_PERF_UDP); elsewhere
+ * there is nothing to send them to. */
+__attribute__((weak)) void ps3_perf_udp(const char* line) { (void)line; }   /* intro 0 title 1 menu 2 level 3 pause 4 gameover 5 */
+
+static void pad_poll_autoplay(unsigned long long now)
+{
+    static int on = -1, last = -2;
+    static unsigned long long next, until;
+    static u16 mask, injected;
+    static unsigned rng = 12345u;
+    if (on < 0) on = getenv("PAD_AUTOPLAY") ? 1 : 0;
+    if (!on) return;
+    const int sc = g_autoplay_screen;
+    if (sc != last) {
+        static const char* const names[6] = { "intro", "title", "menu", "level", "pause", "gameover" };
+        char line[64];
+        snprintf(line, sizeof line, "[autoplay] screen %s\n", sc >= 0 && sc < 6 ? names[sc] : "?");
+        fputs(line, stdout);
+        ps3_perf_udp(line);
+        last = sc;
+    }
+    if (now >= next) {
+        rng = rng * 1103515245u + 12345u;
+        const unsigned r = rng >> 8;
+        switch (sc) {
+        case 1: mask = CELL_PAD_CTRL_START;  until = now + 200; next = now + 3000; break;
+        case 2: mask = CELL_PAD_CTRL_CROSS;  until = now + 200; next = now + 3000; break;
+        case 4: mask = CELL_PAD_CTRL_CIRCLE; until = now + 200; next = now + 3000; break;
+        case 5: mask = CELL_PAD_CTRL_SQUARE; until = now + 200; next = now + 3000; break;
+        case 3: {
+            static const u16 dir[4] = { CELL_PAD_CTRL_UP, CELL_PAD_CTRL_DOWN,
+                                        CELL_PAD_CTRL_LEFT, CELL_PAD_CTRL_RIGHT };
+            mask = dir[r & 3];
+            if (((r >> 2) % 10) < 3) mask |= CELL_PAD_CTRL_CROSS;
+            until = now + 300 + (r >> 4) % 900; next = now + 400;
+            break; }
+        default: mask = 0; next = now + 200; break;
+        }
+    }
+    PadHostState* hs = &s_host_state[0];
+    const u16 m = now < until ? mask : 0;
+    if (m && !hs->connected) {
+        hs->connected = 1;
+        hs->analog_lx = hs->analog_ly = hs->analog_rx = hs->analog_ry = 128;
+    }
+    hs->buttons = (u16)((hs->buttons & ~injected) | m);
+    injected = m;
+}
