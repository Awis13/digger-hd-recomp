+/* Translated shaders are kept on disk, one MSL file per guest program
+ * (<vp|fp>_<hash of its HLSL>.msl): translating a program the first time a
+ * draw needs it (glslang, SPIR-V, spirv-cross) and compiling it held that
+ * frame up, which on an A15 is a visible hitch for every new effect.
+ *   PS3_SHADER_CACHE=<dir>     read and written
+ *   PS3_SHADER_CACHE_RO=<dir>  read only (an app's bundled cache); its
+ *                              programs are also compiled ahead, in the
+ *                              background, when the engine starts.
+ * spirv-cross is run with the same options on every host, so a cache made on
+ * a Mac serves an iPad or an Apple TV. */
+static pthread_mutex_t s_eng_func_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static char* shader_cache_load(const char* what, u64 hash)
+{
+    const char* dirs[2] = { getenv("PS3_SHADER_CACHE_RO"), getenv("PS3_SHADER_CACHE") };
+    for (int d = 0; d < 2; d++) {
+        if (!dirs[d] || !*dirs[d]) continue;
+        char path[1024];
+        snprintf(path, sizeof path, "%s/%s_%016llx.msl", dirs[d], what, (unsigned long long)hash);
+        FILE* f = fopen(path, "rb");
+        if (!f) continue;
+        fseek(f, 0, SEEK_END); const long n = ftell(f); fseek(f, 0, SEEK_SET);
+        char* buf = (n > 0) ? (char*)malloc((size_t)n + 1) : NULL;
+        if (buf && fread(buf, 1, (size_t)n, f) == (size_t)n) { buf[n] = 0; fclose(f); return buf; }
+        free(buf); fclose(f);
+    }
+    return NULL;
+}
+
+static void shader_cache_store(const char* what, u64 hash, const char* msl)
+{
+    const char* dir = getenv("PS3_SHADER_CACHE");
+    if (!dir || !*dir) return;
+    char path[1024], tmp[1040];
+    snprintf(path, sizeof path, "%s/%s_%016llx.msl", dir, what, (unsigned long long)hash);
+    snprintf(tmp, sizeof tmp, "%s.tmp", path);
+    FILE* f = fopen(tmp, "wb");
+    if (!f) return;
+    const size_t n = strlen(msl);
+    const int ok = fwrite(msl, 1, n, f) == n;
+    fclose(f);
+    if (ok) rename(tmp, path); else remove(tmp);
+}
