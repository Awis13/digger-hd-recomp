+/* Built pipelines are kept in a Metal binary archive beside the shader cache
+ * (PS3_SHADER_CACHE/pipelines.binarchive): creating one compiles the shaders
+ * for the GPU, which at the start of a level cost an iPad 80 ms in one go;
+ * from the archive the next run only loads them. New pipelines are added and
+ * the archive written on a background queue, a couple of seconds after the
+ * last one, so the first run does not pay twice. */
+static id<MTLBinaryArchive> s_eng_archive;
+static dispatch_queue_t     s_eng_archive_q;
+static NSURL*               s_eng_archive_url;
+static unsigned             s_eng_archive_dirty;
+
+static void eng_archive_open(void)
+{
+    static int tried;
+    if (tried) return;
+    tried = 1;
+    const char* dir = getenv("PS3_SHADER_CACHE");
+    if (!dir || !*dir) return;
+    s_eng_archive_url = [NSURL fileURLWithPath:
+        [[NSString stringWithUTF8String:dir] stringByAppendingPathComponent:@"pipelines.binarchive"]];
+    MTLBinaryArchiveDescriptor* d = [MTLBinaryArchiveDescriptor new];
+    if ([NSFileManager.defaultManager fileExistsAtPath:s_eng_archive_url.path]) d.url = s_eng_archive_url;
+    NSError* err = nil;
+    s_eng_archive = [s_dev newBinaryArchiveWithDescriptor:d error:&err];
+    if (!s_eng_archive && d.url) {           /* unreadable (another GPU, a new OS): start over */
+        d.url = nil;
+        s_eng_archive = [s_dev newBinaryArchiveWithDescriptor:d error:&err];
+    }
+    s_eng_archive_q = dispatch_queue_create("rsx.pipeline-archive", DISPATCH_QUEUE_SERIAL);
+    fprintf(stderr, "[RSX metal] pipeline archive %s\n",
+            s_eng_archive ? (d.url ? "loaded" : "new") : "unavailable");
+}
+
+static void eng_archive_add(MTLRenderPipelineDescriptor* pd)
+{
+    if (!s_eng_archive) return;
+    MTLRenderPipelineDescriptor* copy = [pd copy];
+    const unsigned gen = ++s_eng_archive_dirty;
+    dispatch_async(s_eng_archive_q, ^{
+        NSError* err = nil;
+        [s_eng_archive addRenderPipelineFunctionsWithDescriptor:copy error:&err];
+    });
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC), s_eng_archive_q, ^{
+        if (gen != s_eng_archive_dirty) return;       /* more came since: a later write */
+        NSError* err = nil;
+        if (![s_eng_archive serializeToURL:s_eng_archive_url error:&err])
+            fprintf(stderr, "[RSX metal] pipeline archive write failed: %s\n",
+                    [[err localizedDescription] UTF8String]);
+    });
+}
