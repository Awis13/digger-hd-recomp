+    pal[1][0] = (u8)(((c1 >> 11) & 31) * 255 / 31); pal[1][1] = (u8)(((c1 >> 5) & 63) * 255 / 63);
+    pal[1][2] = (u8)((c1 & 31) * 255 / 31);         pal[1][3] = 255;
+    if (!bc1 || c0 > c1) {
