+                refs = malloc((size_t)n * (1 + TW * TH));
+                if (refs && fread(refs, 1 + TW * TH, n, f) == n) { nref = n; on = 1; }
+            }
+            fclose(f);
+        }
+        if (getenv("PAD_AUTOPLAY"))
+            fprintf(stderr, "[autoplay] %u reference screens%s\n", nref, on ? "" : " -- not loaded, no autoplay");
