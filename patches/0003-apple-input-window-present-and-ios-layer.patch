+/* The same fallback on macOS. There is no GetAsyncKeyState; the Metal
+ * backend's event pump (rsx_metal_backend.m) records key-down/up for the
+ * game window here, indexed by macOS virtual key code, and clears it all when
+ * the app stops being active. Reading only what the window received keeps
+ * typing in another application away from the game and needs no Input
+ * Monitoring permission. */
+_Atomic unsigned char g_host_key_down[128];
+
+static void pad_poll_keyboard(void)
+{
+    static int off = -1;
+    if (off < 0) off = getenv("PAD_NO_KEYBOARD") ? 1 : 0;
+    if (off) return;
+
+    /* A PC game's keys, by macOS virtual key code (HIToolbox Events.h,
+     * kVK_*): arrows or WASD move, Space is cross (Digger HD fires and
+     * confirms with it), Return is START, Escape is circle (back). */
+    static const struct { unsigned char vk; u16 btn; } map[] = {
+        { 0x7E, CELL_PAD_CTRL_UP },     { 0x7D, CELL_PAD_CTRL_DOWN },       /* arrows */
+        { 0x7B, CELL_PAD_CTRL_LEFT },   { 0x7C, CELL_PAD_CTRL_RIGHT },
+        { 0x0D, CELL_PAD_CTRL_UP },     { 0x01, CELL_PAD_CTRL_DOWN },       /* W S */
+        { 0x00, CELL_PAD_CTRL_LEFT },   { 0x02, CELL_PAD_CTRL_RIGHT },      /* A D */
+        { 0x31, CELL_PAD_CTRL_CROSS },                                      /* Space */
+        { 0x35, CELL_PAD_CTRL_CIRCLE }, { 0x33, CELL_PAD_CTRL_CIRCLE },     /* Escape, Delete */
+        { 0x0C, CELL_PAD_CTRL_SQUARE }, { 0x0E, CELL_PAD_CTRL_TRIANGLE },   /* Q E */
+        { 0x24, CELL_PAD_CTRL_START },  { 0x4C, CELL_PAD_CTRL_START },      /* Return, keypad Enter */
+        { 0x23, CELL_PAD_CTRL_START },                                      /* P */
+        { 0x30, CELL_PAD_CTRL_SELECT },                                     /* Tab */
+        { 0x12, CELL_PAD_CTRL_L1 },     { 0x13, CELL_PAD_CTRL_R1 },         /* 1 2 */
+        { 0x14, CELL_PAD_CTRL_L2 },     { 0x15, CELL_PAD_CTRL_R2 },         /* 3 4 */
+    };
+
+    PadHostState* hs = &s_host_state[0];
+    u16 btns = 0;
+    for (unsigned i = 0; i < sizeof map / sizeof map[0]; i++)
+        if (g_host_key_down[map[i].vk]) btns |= map[i].btn;
+
+    hs->buttons   = btns;
+    hs->connected = 1;
+    hs->analog_lx = (u8)((btns & CELL_PAD_CTRL_LEFT) ? 0 :
+                         (btns & CELL_PAD_CTRL_RIGHT) ? 255 : 128);
+    hs->analog_ly = (u8)((btns & CELL_PAD_CTRL_UP) ? 0 :
+                         (btns & CELL_PAD_CTRL_DOWN) ? 255 : 128);
+    hs->analog_rx = hs->analog_ry = 128;
+    hs->trigger_l2 = (u8)((btns & CELL_PAD_CTRL_L2) ? 255 : 0);
+    hs->trigger_r2 = (u8)((btns & CELL_PAD_CTRL_R2) ? 255 : 0);
+
+    { static int said = 0;
+      if (!said && btns) { said = 1;
+          printf("[cellPad] keyboard fallback active on port 0 (no game controller)\n");
+          fflush(stdout); } }
+}
