+/* PAD_AUTOPLAY: twice a second, which screen the frame is -- a 64x36 grey
+ * thumbnail (PIL's bilinear downscale, as tools/playtest.py makes them)
+ * matched to the nearest reference in $PAD_AUTOPLAY_REFS -- for cellPad's
+ * autoplay to answer. */
+extern volatile int g_autoplay_screen;
+static void eng_autoplay_classify(id<MTLTexture> src)
+{
+    enum { TW = 64, TH = 36 };
+    static int on = -1; static unsigned frame;
+    static unsigned char* refs; static unsigned nref;
+    if (on < 0) {
+        on = 0;
+        const char* path = getenv("PAD_AUTOPLAY_REFS");
+        FILE* f = (getenv("PAD_AUTOPLAY") && path) ? fopen(path, "rb") : NULL;
+        if (f) {
