+static id<MTLFunction> eng_func_lookup(u64 hash, int* found)
+{
+    id<MTLFunction> fn = nil; *found = 0;
+    pthread_mutex_lock(&s_eng_func_lock);
+    for (u32 i = 0; i < s_eng_func_count; i++)
+        if (s_eng_func[i].hash == hash) { fn = s_eng_func[i].fn; *found = 1; break; }
+    pthread_mutex_unlock(&s_eng_func_lock);
+    return fn;
+}
+
+static void eng_func_insert(u64 hash, id<MTLFunction> fn)
+{
+    pthread_mutex_lock(&s_eng_func_lock);
+    for (u32 i = 0; i < s_eng_func_count; i++)
+        if (s_eng_func[i].hash == hash) { pthread_mutex_unlock(&s_eng_func_lock); return; }
+    if (s_eng_func_count < ENG_MAX_FUNCS) {
+        s_eng_func[s_eng_func_count].hash = hash;
+        s_eng_func[s_eng_func_count].fn   = fn;
+        s_eng_func_count++;
+    }
+    pthread_mutex_unlock(&s_eng_func_lock);
+}
