+/* ---------------------------------------------------------------------------
+ * RSX hand-off for short sleeps (POSIX)
+ *
+ * A title waits for the RSX in a loop of short sleeps (Digger HD: 300 and
+ * 800 us, about 2600 a second), checking a label or the ring each time, while
+ * the RSX thread drains on its own cadence. Every hand-off then cost a nap on
+ * each side, dozens of times a frame -- on an Apple TV the gap to 60 fps. So a
+ * short sleep first wakes the RSX thread (g_rsx_kick, set by the host) and
+ * then waits until the drain makes progress (ps3_rsx_progress) or the time
+ * is up, whichever comes first. The loop re-checks either way.
+ * Off unless PS3_USLEEP_HANDOFF=1: measured on an Apple TV it gained nothing
+ * once the present stopped blocking the RSX thread (mailbox present).
+ * -----------------------------------------------------------------------*/
+#ifndef _WIN32
+void (*g_rsx_kick)(void);
+static pthread_mutex_t s_prog_mu = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t  s_prog_cv = PTHREAD_COND_INITIALIZER;
+static unsigned long   s_prog_gen;
+static volatile int    s_prog_waiters;
+
+void ps3_rsx_progress(void)
+{
+    if (!__atomic_load_n(&s_prog_waiters, __ATOMIC_ACQUIRE)) return;
+    pthread_mutex_lock(&s_prog_mu);
+    s_prog_gen++;
+    pthread_cond_broadcast(&s_prog_cv);
+    pthread_mutex_unlock(&s_prog_mu);
+}
+
+static int usleep_handoff(uint64_t usec)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3_USLEEP_HANDOFF"); on = e && *e == '1'; }
+    if (!on || usec > 2000 || !g_rsx_kick) return 0;
+    struct timespec dl;
+    clock_gettime(CLOCK_REALTIME, &dl);
+    dl.tv_nsec += (long)(usec * 1000);
+    if (dl.tv_nsec >= 1000000000L) { dl.tv_sec++; dl.tv_nsec -= 1000000000L; }
+    pthread_mutex_lock(&s_prog_mu);
+    const unsigned long gen = s_prog_gen;
+    __atomic_add_fetch(&s_prog_waiters, 1, __ATOMIC_ACQ_REL);
+    pthread_mutex_unlock(&s_prog_mu);
+    g_rsx_kick();
+    pthread_mutex_lock(&s_prog_mu);
+    while (s_prog_gen == gen)
+        if (pthread_cond_timedwait(&s_prog_cv, &s_prog_mu, &dl) != 0) break;
+    __atomic_sub_fetch(&s_prog_waiters, 1, __ATOMIC_ACQ_REL);
+    pthread_mutex_unlock(&s_prog_mu);
+    return 1;
+}
+#else
+void ps3_rsx_progress(void) {}
+#endif
