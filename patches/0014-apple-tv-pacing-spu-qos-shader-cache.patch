         ts.tv_nsec = (long)((usec % 1000000) * 1000);
-        nanosleep(&ts, NULL);
+        struct timespec t0, t1;
+        clock_gettime(CLOCK_MONOTONIC, &t0);
+        if (!usleep_handoff(usec)) nanosleep(&ts, NULL);
+        clock_gettime(CLOCK_MONOTONIC, &t1);
+        /* PS3RECOMP_METAL_FPS=1 diagnostic: what the guest asks to sleep and
