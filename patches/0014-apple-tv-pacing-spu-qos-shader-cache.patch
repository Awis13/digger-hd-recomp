+#elif defined(__APPLE__)
+#include <pthread.h>
+/* Darwin names only the calling thread, which is exactly this contract. */
+static inline void ps3_thread_name(const char* fmt, ...)
+{
+    char s[64];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(s, sizeof s, fmt, ap);
+    va_end(ap);
+    pthread_setname_np(s);
+}
