 static inline void ps3_thread_name(const char* fmt, ...) { (void)fmt; }
 #endif
 
+/* ps3_thread_hot: the calling thread runs SPU code a frame waits on. On Apple
+ * silicon the scheduler picks the core type and clock from QoS, and at the
+ * default an SPU thread is free to land on an efficiency core at a third of
+ * the speed -- on an Apple TV's A15 the frame then waits for it. Only these
+ * few threads are raised (with the guest's main thread and the RSX thread),
+ * not every thread: all of them at the top burns the energy budget.
+ * PS3_SPU_QOS=default leaves them alone. */
+#if defined(__APPLE__)
+#include <pthread/qos.h>
+#include <stdlib.h>
+#include <string.h>
+static inline void ps3_thread_hot(void)
+{
+    const char* e = getenv("PS3_SPU_QOS");
+    if (e && !strcmp(e, "default")) return;
+    pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+}
+#else
+static inline void ps3_thread_hot(void) {}
+#endif
+
 #endif /* PS3EMU_THREAD_NAME_H */
