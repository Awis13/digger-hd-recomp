+                                    (unsigned long long)(edge[k] == ~0ull ? 99999 : edge[k]),
+                                    (unsigned long long)n[k], (unsigned long long)(req[k] / n[k]),
+                                    (unsigned long long)(got[k] / n[k]));
+                snprintf(line + len, sizeof line - len, "\n");
+                fputs(line, stderr);
+                { extern void ps3_perf_udp(const char*); ps3_perf_udp(line); }
+                memset(n, 0, sizeof n); memset(req, 0, sizeof req); memset(got, 0, sizeof got);
+            } } }
     }
