+/* Ring geometry for the title's buffer-full callback (cellGcm_fifo_recycle),
+ * which hands the title its ring the way the SDK's default callback does:
+ * after a wrap the title may write from `begin` up to where the RSX is still
+ * reading the previous lap, and ctx->end is lowered to say so. The RSX never
+ * waits for the title and the title never writes over commands the RSX has
+ * not read.
+ *
+ * s_ring_end_ea   the ring's real end: ctx->end as the title first set it.
+ * s_ring_jumps    the wrap JUMPs the walker still owes (see above). */
+/* Room the callback must give the title before it returns: more than the
+ * largest single reserve (a method header carries at most 2047 words). */
+#define GCM_RING_MIN_ROOM 0x10000u
+/* Distance kept between the title's limit and the walker. */
+#define GCM_RING_GUARD    0x1000u
+
+/* Where the title may write up to now, as an EA (begin when it may not write
+ * at all), or 0 while that cannot be known. On the title's lap the walker is
+ * behind it and the whole ring is free; one lap behind, the title may write
+ * up to the walker; two laps behind, nothing until it catches up. */
+static u32 gcm_ring_limit(u32 begin, u32 current)
+{
+    const unsigned laps = gcm_ring_laps_behind();
+    if (laps == 0) return s_ring_end_ea;
+    if (laps > 1) return begin;
+    const u32 g = gcm_io2ea(s_fifo_getoff);
+    if (!g || g < current || g > s_ring_end_ea) return 0;   /* in a CALL, or resynced */
+    return g > begin + GCM_RING_GUARD ? g - GCM_RING_GUARD : begin;
+}
